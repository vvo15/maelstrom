# Copy this to .env — never commit .env
# LLM provider: "anthropic" or "mock" (mock needs no API key)
SIREN_LLM=mock

# Required when SIREN_LLM=anthropic
ANTHROPIC_API_KEY=

# Model names (defaults used when blank)
MAZE_MODEL=claude-haiku-4-5
ATTACKER_MODEL=claude-haiku-4-5

# Attacker mode: "scripted" or "llm"
ATTACKER_MODE=scripted
